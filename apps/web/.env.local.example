# ─── Supabase Database ──────────────────────────────────────────
# Pooled connection (for app queries) — from Supabase Dashboard > Settings > Database > Connection pooling
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (for Prisma migrations only)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── JWT Secrets ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_min_32_chars"
JWT_REFRESH_SECRET="CHANGE_ME_min_32_chars_different"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
NEXT_PUBLIC_APP_URL="https://your-domain.com"

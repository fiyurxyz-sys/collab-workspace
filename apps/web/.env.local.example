# ─── Neon / Vercel Postgres ─────────────────────────────────────
# These are auto-added by Vercel when you connect a Neon database.
# For local dev, get them from: Vercel Dashboard > Your Project > Settings > Environment Variables
POSTGRES_PRISMA_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=10"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/dbname"

# ─── JWT Secrets ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_min_32_chars"
JWT_REFRESH_SECRET="CHANGE_ME_min_32_chars_different"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
